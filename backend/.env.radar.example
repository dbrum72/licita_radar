APP_NAME=LicitaRadar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=licitaRadar_bd
DB_USERNAME=root
DB_PASSWORD=
CACHE_STORE=database
QUEUE_CONNECTION=null
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=radar@licitaradar.test
MAIL_FROM_NAME=LicitaRadar

FRONTEND_URL=http://127.0.0.1:5173,http://localhost:5173
JWT_TTL=60
JWT_ISSUER=licitaradar-api
JWT_AUDIENCE=licitaradar-frontend
# Optional: separate random signing secret of at least 32 bytes. Otherwise derived from APP_KEY.
JWT_SECRET=

# OpenAI documentary analysis (manual, server-side only). Never set a VITE_ key.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_ANALYSIS_REASONING_EFFORT=medium
OPENAI_ANALYSIS_TIMEOUT=180
OPENAI_ANALYSIS_MAX_OUTPUT_TOKENS=16000
OPENAI_ANALYSIS_MAX_DOCUMENTS=40
OPENAI_ANALYSIS_MAX_TEXT_CHARS=500000
OPENAI_ANALYSIS_MAX_CALLS=8
